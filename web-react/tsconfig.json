{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting. Unused-variable style is enforced by ESLint, not here: this
       build also typechecks the parent interpreter sources, which are not
       held to noUnusedLocals. */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@pie/*": ["../src/pie-interpreter/*"],
      "@scheme/*": ["../src/scheme-parser/*"]
    }
  },
  "include": ["src", "../src/pie-interpreter", "../src/scheme-parser"],
  "exclude": [
    "../src/pie-interpreter/__tests__",
    "../src/pie-interpreter/index.ts",
    "../src/pie-interpreter/pie-evaluator.ts"
  ]
}
